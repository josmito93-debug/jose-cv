<svg class="art art--seo" viewBox="0 0 360 220" aria-hidden="true">
  <defs>
    <linearGradient id="artSeoSpark" x1="0" y1="1" x2="1" y2="0">
      <stop offset="0" stop-color="#2ee58f" stop-opacity="0"/>
      <stop offset="1" stop-color="#2ee58f"/>
    </linearGradient>
  </defs>
  <!-- resultados -->
  <g class="art-seo-rows">
    <g>
      <rect x="26" y="34" width="168" height="36" rx="10" fill="var(--art-panel)" stroke="var(--art-soft)"/>
      <rect x="38" y="45" width="14" height="14" rx="4" fill="var(--art-soft)"/>
      <rect x="60" y="44" width="86" height="5" rx="2.5" fill="var(--art-soft)"/>
      <rect x="60" y="55" width="58" height="5" rx="2.5" fill="var(--art-soft)" opacity=".55"/>
    </g>
    <g class="art-seo-win">
      <rect x="26" y="80" width="168" height="36" rx="10" fill="rgba(46,229,143,.13)" stroke="#2ee58f"/>
      <rect x="38" y="91" width="14" height="14" rx="4" fill="#2ee58f"/>
      <rect x="60" y="90" width="96" height="5" rx="2.5" fill="var(--art-ink)"/>
      <rect x="60" y="101" width="66" height="5" rx="2.5" fill="var(--art-ink)" opacity=".55"/>
    </g>
    <g>
      <rect x="26" y="126" width="168" height="36" rx="10" fill="var(--art-panel)" stroke="var(--art-soft)"/>
      <rect x="38" y="137" width="14" height="14" rx="4" fill="var(--art-soft)"/>
      <rect x="60" y="136" width="78" height="5" rx="2.5" fill="var(--art-soft)"/>
      <rect x="60" y="147" width="50" height="5" rx="2.5" fill="var(--art-soft)" opacity=".55"/>
    </g>
  </g>
  <!-- ascenso -->
  <path class="art-seo-rise" pathLength="1" d="M14 158 C 8 120, 8 96, 16 74" fill="none" stroke="url(#artSeoSpark)" stroke-width="2.4" stroke-linecap="round"/>
  <path class="art-seo-tip" d="M10 80 L16 70 L22 80" fill="none" stroke="#2ee58f" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"/>
  <!-- lupa -->
  <g class="art-seo-lens">
    <circle cx="272" cy="96" r="46" fill="var(--art-panel)" stroke="var(--art-ink)" stroke-width="2.4"/>
    <path d="M305 130 L330 156" stroke="var(--art-ink)" stroke-width="6" stroke-linecap="round"/>
    <path class="art-seo-line" pathLength="1" d="M240 116 L254 100 L266 108 L282 84 L296 92 L304 74" fill="none" stroke="#2ee58f" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"/>
    <g class="art-seo-orbit">
      <circle cx="272" cy="38" r="3.4" fill="#7a3ff2"/>
      <circle cx="326" cy="118" r="2.6" fill="#2ee58f"/>
    </g>
  </g>
</svg>

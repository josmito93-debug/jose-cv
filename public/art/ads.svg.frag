<svg class="art art--ads" viewBox="0 0 360 220" aria-hidden="true">
  <defs>
    <linearGradient id="artAdsBeam" x1="0" y1="0" x2="1" y2="0">
      <stop offset="0" stop-color="#2ee58f" stop-opacity="0"/>
      <stop offset=".5" stop-color="#2ee58f" stop-opacity=".9"/>
      <stop offset="1" stop-color="#2ee58f" stop-opacity="0"/>
    </linearGradient>
  </defs>
  <!-- variante A -->
  <g class="art-ads-a">
    <rect x="42" y="42" width="118" height="128" rx="12" fill="var(--art-panel)" stroke="var(--art-soft)" stroke-width="2"/>
    <rect x="56" y="56" width="90" height="52" rx="8" fill="var(--art-soft)" opacity=".5"/>
    <rect x="56" y="118" width="90" height="6" rx="3" fill="var(--art-soft)"/>
    <rect x="56" y="130" width="62" height="6" rx="3" fill="var(--art-soft)" opacity=".6"/>
    <rect x="56" y="146" width="46" height="12" rx="6" fill="none" stroke="var(--art-soft)"/>
    <text x="152" y="60" text-anchor="middle" class="art-ads-tag">A</text>
  </g>
  <!-- variante B (ganadora) -->
  <g class="art-ads-b">
    <rect class="art-ads-bframe" x="200" y="42" width="118" height="128" rx="12" fill="var(--art-panel)" stroke="var(--art-soft)" stroke-width="2"/>
    <rect x="214" y="56" width="90" height="52" rx="8" fill="rgba(46,229,143,.2)"/>
    <path d="M222 100 L242 76 L258 88 L276 66" fill="none" stroke="#2ee58f" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"/>
    <rect x="214" y="118" width="90" height="6" rx="3" fill="var(--art-ink)"/>
    <rect x="214" y="130" width="62" height="6" rx="3" fill="var(--art-ink)" opacity=".6"/>
    <rect class="art-ads-cta" x="214" y="146" width="46" height="12" rx="6" fill="#2ee58f"/>
    <text x="310" y="60" text-anchor="middle" class="art-ads-tag">B</text>
  </g>
  <!-- métrica que sube -->
  <g class="art-ads-up">
    <path d="M259 30 L259 12 M251 20 L259 10 L267 20" fill="none" stroke="#2ee58f" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"/>
  </g>
  <!-- audiencia -->
  <circle class="art-ads-dot art-ads-dot--1" cx="16" cy="80" r="3.2" fill="#7a3ff2"/>
  <circle class="art-ads-dot art-ads-dot--2" cx="10" cy="120" r="2.6" fill="#2ee58f"/>
  <circle class="art-ads-dot art-ads-dot--3" cx="20" cy="158" r="2.9" fill="var(--art-soft)"/>
  <!-- barrido -->
  <line class="art-ads-scan" x1="0" y1="34" x2="0" y2="186" stroke="url(#artAdsBeam)" stroke-width="3"/>
</svg>
